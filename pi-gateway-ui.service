# /etc/unbound/unbound.conf.d/dns64.conf
# DNS64 — synthesises AAAA records for IPv4-only destinations
# using the same prefix as Jool (64:ff9b::/96)

server:
  # Listen on all interfaces, port 53
  interface: 0.0.0.0
  interface: ::0
  port: 53

  # Allow queries from local network
  access-control: 127.0.0.0/8 allow
  access-control: ::1/128 allow
  access-control: 10.0.0.0/8 allow
  access-control: 192.168.0.0/16 allow
  access-control: 172.16.0.0/12 allow
  access-control: fd00::/8 allow

  # Enable DNSSEC validation
  auto-trust-anchor-file: "/var/lib/unbound/root.key"

  # Logging (optional — disable on production for performance)
  # logfile: "/var/log/unbound.log"
  # log-queries: yes

  # DNS64 module must come before iterator
  module-config: "dns64 iterator"

# DNS64 prefix must match Jool's pool6
dns64:
  prefix: 64:ff9b::/96

# Forward queries to Cloudflare IPv6 DNS
forward-zone:
  name: "."
  forward-addr: 2606:4700:4700::1111
  forward-addr: 2606:4700:4700::1001
