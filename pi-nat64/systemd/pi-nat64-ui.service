[Unit]
Description=pi-nat64 Web UI
After=network.target hostapd.service unbound.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pi-nat64/web
Environment=SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRING
ExecStart=/usr/bin/python3 /opt/pi-nat64/web/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
